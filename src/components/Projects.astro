</section>

<style>
    section {
        width: 100%;
        min-height: 100%;
        background-color: #191919;
    }

    .container-projects {
        max-width: 1100px;
        padding: 2rem 1rem 2rem 1rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .container-1 {
        margin-bottom: 3rem;
    }

    .container-1 h2 {
        color: #fff;
        text-align: center;
        font-weight: 400;
    }

    .projects {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        width: 100%;
        justify-content: center;
    }

    .projects article {
        background-color: #232323;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1); 
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease;
    }

    .projects article.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .projects article.is-visible:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
        border-color: rgba(123, 243, 203, 0.3);
    }

    @media (prefers-reduced-motion: reduce) {
        .projects article {
            opacity: 1;
            transform: none;
            transition: box-shadow 0.35s ease, border-color 0.35s ease;
        }
    }

    .container-2 {
        height: 220px;
        width: 100%;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .container-2 img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .container-3 {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 1.5rem;
        flex-grow: 1;
    }

    .container-3 h3 {
        color: #fff;
        font-weight: 400;
        text-align: center;
    }

    .container-4 {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: auto;
    }

    .container-4 img {
        width: 25px;
        height: 25px;
    }
    

    .container-3 a {
        background-color: #333;
        border: 1px solid transparent;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        padding: 0.8rem 1.5rem;
        width: 100%;
        box-sizing: border-box;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
    }

    .container-3 a:hover {
        background-color: #444;
        border-color: #666;
        transform: scale(1.02);
    }

    .container-3 a span {
        color: #fff;
        font-size: 0.95rem;
        font-weight: 500;
    }
</style>