---

const props = Astro.props

---

<footer class="status-bar">
    <div class="status-left">
        <span class="status-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" {...props}>
                <g fill="none" stroke="#101010" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M6 3v12" />
                    <circle cx="18" cy="6" r="3" />
                    <circle cx="6" cy="18" r="3" />
                    <path d="M18 9a9 9 0 0 1-9 9" />
                </g>
            </svg>
            main
        </span>
        <span class="status-item status-item-desktop">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" {...props}>
                <path fill="none" stroke="#101010" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m20 6l-11 11l-5-5" />
            </svg>
            sin errores
        </span>
    </div>
    <div class="status-right">
        <a href="https://github.com/Guardatti" target="_blank" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" {...props}>
                <g fill="none" stroke="#101010" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5c.08-1.25-.27-2.48-1-3.5c.28-1.15.28-2.35 0-3.5c0 0-1 0-3 1.5c-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5c-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                </g>
            </svg>
        </a>
        <a href="https://www.linkedin.com/in/nicol%C3%A1s-guardatti-14b22125b/" target="_blank" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" {...props}>
                <g fill="none" stroke="#101010" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2a2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6M2 9h4v12H2z" />
                    <circle cx="4" cy="4" r="2" />
                </g>
            </svg>
        </a>
        <a href="https://www.instagram.com/nicoo_guardatti/" target="_blank" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" {...props}>
                <g fill="none" stroke="#101010" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8A4 4 0 0 1 16 11.37m1.5-4.87h.01" />
                </g>
            </svg>
        </a>
        <span class="status-item status-item-desktop">UTF-8</span>
        <span class="status-item status-item-desktop">Astro</span>
        <span class="status-copyright">Nicolás Guardatti</span>
    </div>
</footer>

<style>

    .status-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 26px;
        min-height: 26px;
        background-color: #7BF3CB;
        padding: 0 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11.5px;
        color: #101010;
        font-weight: 500;
    }

    .status-left, .status-right {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .status-right a {
        display: flex;
        align-items: center;
        opacity: 0.85;
        transition: opacity 0.15s ease;
    }

    .status-right a:hover {
        opacity: 1;
    }

    .status-copyright {
        white-space: nowrap;
    }

    @media screen and (max-width: 640px) {
        .status-item-desktop, .status-copyright {
            display: none;
        }
    }

</style>
