<section id="sobre-mi" class="editor-panel">
    <div class="container-aboutme">
        <div class="container-info" data-fade-in>
            <h2>Sobre mí</h2>
            <div class="container-1">
                <p> Soy desarrollador full stack [MERN] y estudiante de Ingeniería en Sistemas en la UTN FRC.</p>
                <p>He trabajado en proyectos consumiendo APIs externas, así como en aplicaciones completas donde he diseñado tanto el frontend como el backend.</p>
                <p>Me apasiona el desarrollo web y siempre busco mejorar mis habilidades, tanto en el front-end como en el back-end.</p>
            </div>
        </div>
        <div class="container-tools" data-fade-in>
            <h2>Herramientas</h2>
            <ul class="tools">
                {
                    toolItems.map((x) => {
                        return(
                            <li data-tool-item>
                                <a href={x.href} target="_blank">
                                    <img src={x.src} alt={x.name} />
                                    <span>{x.name}</span>
                                </a>
                            </li>
                        )
                    })
                }
            </ul>
        </div>
    </div>
</section>

<style>

    section {
        background-color: #101010;
        width: 100%;
        min-height: 100%;
    }

    .container-aboutme {
        max-width: 768px;
        margin: 0 auto;
        padding: 2rem 1rem 2rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
    }

    .container-info, .container-tools {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .container-info h2, .container-info p, .container-tools h2 {
        color: #fff;
        font-weight: 400;
        text-align: center;
    }

    .container-1, .tools {
        padding-top: 2rem;
    }

    .tools {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 45px;
    }

    .tools li {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #fff;
        border-color: #797979; 
        border-radius: 10px;
        background-color: #12131b;
        height: 150px;
        width: 150px;
        transition: 0.3s ease-in;
    }

    .tools li:hover {
        transform: scale(1.05) !important;
        transition: 0.3s ease-out;
    }

    .tools li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 15px;
        width: 100%;
        height: 100%;
    }

    .tools li a img {
        width: 60px;
        height: 60px;
    }

    .tools li a span {
        color: #fff;
    } 

    [data-fade-in], [data-tool-item] {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-fade-in].is-visible, [data-tool-item].is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        [data-fade-in], [data-tool-item] {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

</style>