---

import Form from "./Form.tsx";
import "../styles/form.css";

---

<section id="contacto" class="editor-panel">
    <div class="container-form">
        <div data-contact-fade>
            <h2>Contacto</h2>
        </div>
        <div class="container-form">
            <Form client:only="react"/>
        </div>
    </div>
</section>

<style>

    section { 
        width: 100%;
        min-height: 100%;
        background-color: #101010;
    }

    .container-form {
        max-width: 768px;
        margin: 0 auto;
        padding: 2rem 1rem 2rem 1rem;
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .container-form div h2 {
        color: #fff;
        text-align: center;
        font-weight: 400;
    }

    [data-contact-fade] {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-contact-fade].is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        [data-contact-fade] {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }

</style>